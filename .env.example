# Скопируйте в .env.local и заполните.
# Без TELEGRAM_* заявки всё равно сохраняются в SQLite, а текст уведомления
# печатается в консоль сервера — сайт продолжает работать.

# 1. В Telegram напишите @BotFather → /newbot → получите токен.
TELEGRAM_BOT_TOKEN=
# 2. Напишите своему боту любое сообщение, затем откройте:
#    https://api.telegram.org/bot<ТОКЕН>/getUpdates
#    и возьмите chat.id (у группы id отрицательный, начинается с -100).
TELEGRAM_CHAT_ID=

# Публичный адрес сайта — нужен для canonical, Open Graph и sitemap.
NEXT_PUBLIC_SITE_URL=https://mafia-barbershop.ru

# Необязательно: путь к файлу базы относительно корня проекта.
# MAFIA_DB_PATH=./data/mafia.db

# --- Синхронизация с 2ГИС, Яндекс Картами и VK ---
# Адрес запущенного сайта: сюда стучится scripts/sync.ps1.
MAFIA_SITE_URL=http://127.0.0.1:3100
# Секрет для POST /api/sync. Пока пусто — endpoint доступен только с этой
# машины. На боевом сервере обязательно задайте длинную строку.
SYNC_TOKEN=

# VK: сервисный ключ необязателен. С ним посты берутся через официальный API,
# без него — через публичный виджет сообщества.
# Ключ: dev.vk.com → «Мои приложения» → приложение → «Сервисный ключ доступа».
VK_TOKEN=
VK_GROUP=barbershopmafia2024

# Идентификаторы карточек. Менять только если карточку пересоздали.
TWOGIS_BRANCH_ID=70000001089574253
# Публичный ключ отзывов 2ГИС (тот, что использует сайт 2gis.ru).
# Если 2ГИС начнёт отвечать «incorrect key» — подставьте актуальный сюда.
TWOGIS_REVIEWS_KEY=
YANDEX_ORG_ID=83250055703
